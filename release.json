{
  "name": "Nebula Game",
  "entry": "main.py",
  "executable": "NebulaGame",
  "archive": "nebula_game",
  "version": {"file": "main.py", "pattern": "^VERSION = \"([^\"]+)\""},
  "assets": ["sounds", "images", "data", "readme.txt"],
  "native_packages": ["cyal", "prism", "_soundfile_data"],
  "licenses": "off",
  "nuitka_args": {
    "all": ["--lto=yes"],
    "windows": [],
    "linux": [],
    "macos": []
  },
  "python": "3.12",
  "systems": ["windows", "linux", "macos-arm64", "macos-x86_64"],
  "macos": {"bundle_id": "com.tunmi13.nebulagame", "minimum": "11.0"},
  "venv": "env"
}
